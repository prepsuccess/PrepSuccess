// PrepSuccess database schema (PostgreSQL on Supabase).
// Connection URLs live in prisma.config.ts.
// Conventions (docs/PRODUCTION_STANDARDS.md §2): UUID primary keys,
// timestamptz created_at/updated_at, snake_case tables/columns via @@map/@map,
// soft delete (is_deleted) on admin-managed content and users.
//
// Phase 1 (AI-first) — SCRUM-10, SCRUM-119..123:
//   users              identity + auth only
//   user_profiles      everything the AI onboarding collects (JSONB)
//   refresh_tokens     hashed, rotatable refresh tokens
//   email_otps         hashed one-time passwords
//   skills             shared taxonomy (reused by the Phase 2 question bank)
//   assessments        one adaptive attempt on one skill
//   assessment_results score + mastery verdict for an attempt
//   ai_conversations   turn-by-turn AI chat log
//   practical_tasks / user_task_submissions / learning_resources
//   check_questions    the reusable question bank behind skill checks (100 per skill)
//   ai_usage           one row per AI call — the free-trial meter (SCRUM-129)
//   notifications      in-app notifications (SCRUM-48)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
  LOGIN
}

enum SkillCategory {
  TECHNICAL
  SOFT
  APTITUDE
}

enum AgentType {
  ONBOARDING
  ASSESSMENT
  DASHBOARD
  COACH
}

enum AssessmentMode {
  DIAGNOSTIC
  TASK
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum MasteryStatus {
  MASTERED
  NEEDS_REVISION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ResourceType {
  REFERENCE
  EXAMPLE
  LECTURE
  PRACTICE
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

/// Identity and authentication only. Everything descriptive about the student
/// (education, skills, goals, age, mobile, ...) lives in UserProfile.profileData.
model User {
  id              String       @id @default(uuid()) @db.Uuid
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String?      @map("last_name") @db.VarChar(100)
  /// Always stored normalized (trimmed + lowercased) by the auth service.
  email           String       @unique @db.VarChar(255)
  /// Null for Google-only accounts.
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  googleId        String?      @unique @map("google_id") @db.VarChar(255)
  authProvider    AuthProvider @default(LOCAL) @map("auth_provider")
  role            Role         @default(STUDENT)
  profileImageUrl String?      @map("profile_image_url") @db.VarChar(500)
  isVerified      Boolean      @default(false) @map("is_verified")
  isActive        Boolean      @default(true) @map("is_active")
  isDeleted       Boolean      @default(false) @map("is_deleted")
  lastLoginAt     DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile           UserProfile?
  refreshTokens     RefreshToken[]
  conversations     AIConversation[]
  assessments       Assessment[]
  taskSubmissions   UserTaskSubmission[]
  aiUsage           AiUsage[]
  notifications     Notification[]
  activity          UserActivity?
  questionsAuthored QuestionBank[]         @relation("QuestionAuthor")
  questionProgress  UserQuestionProgress[]

  @@map("users")
}

/// One per user, written by the AI onboarding conversation. profileData is
/// schemaless JSONB so new onboarding questions don't need a migration.
model UserProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  /// e.g. { age, mobile_no, location, education: { college, branch, year },
  ///        target_role, skills_claimed: [...], experience, interests, goals }
  profileData           Json      @default("{}") @map("profile_data")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Refresh tokens are stored hashed and rotated on every use (PRODUCTION_STANDARDS §3.1).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Why it was revoked: "rotated" (replaced by a refresh), "logout", "password_reset",
  /// "admin" or "reuse". Only replaying a rotated token is treated as theft.
  revokeReason String?   @map("revoke_reason") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Hashed 6-digit codes; 10-minute expiry, max 3 attempts (SYSTEM_ARCHITECTURE_FLOW §2.2).
model EmailOtp {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @db.VarChar(255)
  otpHash   String     @map("otp_hash") @db.VarChar(255)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean    @default(false) @map("is_used")
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose, createdAt])
  @@map("email_otps")
}

// ---------------------------------------------------------------------------
// Skills & adaptive assessment
// ---------------------------------------------------------------------------

/// Shared taxonomy — reused unchanged by the Phase 2 question bank.
model Skill {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(100)
  slug             String        @unique @db.VarChar(120)
  category         SkillCategory
  topic            String?       @db.VarChar(100)
  subtopic         String?       @db.VarChar(100)
  description      String?
  /// Percentage (0-100) a student must reach to be MASTERED. Per-skill so it
  /// can vary by difficulty (open question in PROJECT_CONTEXT §12).
  masteryThreshold Int           @default(40) @map("mastery_threshold")
  isActive         Boolean       @default(true) @map("is_active")
  isDeleted        Boolean       @default(false) @map("is_deleted")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessments    Assessment[]
  checkQuestions CheckQuestion[]
  questions      QuestionBank[]
  prepPdfs       PrepPdf[]
  practicalTasks PracticalTask[]
  resources      LearningResource[]

  @@index([category])
  @@map("skills")
}

/// One adaptive attempt on one skill. Retakes create new rows, which gives
/// Phase 2 its progress-over-time history.
model Assessment {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  skillId       String           @map("skill_id") @db.Uuid
  mode          AssessmentMode   @default(DIAGNOSTIC)
  status        AssessmentStatus @default(IN_PROGRESS)
  /// How many questions the student chose for this check (10-30; older checks had 5).
  questionCount Int              @default(5) @map("question_count")
  /// The AI-generated question pool and every answer given (assessment.logic.ts):
  /// [{ id, difficulty, question, options, answer_index, explanation,
  ///    asked_order, chosen_index, correct, answered_at }]. answer_index never leaves the server.
  questions     Json             @default("[]")
  startedAt     DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill         Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)
  result        AssessmentResult?
  conversations AIConversation[]

  @@index([userId, skillId])
  @@map("assessments")
}

/// Score and mastery verdict for one attempt. threshold is copied from the
/// skill at scoring time so later threshold changes don't rewrite history.
model AssessmentResult {
  id            String        @id @default(uuid()) @db.Uuid
  assessmentId  String        @unique @map("assessment_id") @db.Uuid
  score         Float
  maxScore      Float         @map("max_score")
  threshold     Int
  masteryStatus MasteryStatus @map("mastery_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}

/// Turn-by-turn log of an AI chat. assessmentId is set for assessment chats.
model AIConversation {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  agentType    AgentType @map("agent_type")
  assessmentId String?   @map("assessment_id") @db.Uuid
  /// [{ role: "user" | "assistant", content, created_at }, ...]
  messages     Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([userId, agentType])
  @@map("ai_conversations")
}

/// The question bank for skill checks: AI-written multiple-choice questions,
/// saved and reused across students (up to 100 per skill), so each check is
/// drawn from it instead of written from scratch. Answers are marked on the
/// server; answerIndex never leaves it until the question is answered.
model CheckQuestion {
  id           String     @id @default(uuid()) @db.Uuid
  skillId      String     @map("skill_id") @db.Uuid
  difficulty   Difficulty
  question     String
  /// Exactly four options, in canonical order; shuffled per check.
  options      Json
  answerIndex  Int        @map("answer_index")
  explanation  String
  /// Normalised-text hash, so the same question is never stored twice for a skill.
  fingerprint  String     @db.VarChar(64)
  /// "ai" today; "admin" once admins can author questions.
  source       String     @default("ai") @db.VarChar(20)
  /// Quality signals: how often it was answered, and answered right.
  timesAsked   Int        @default(0) @map("times_asked")
  timesCorrect Int        @default(0) @map("times_correct")
  isActive     Boolean    @default(true) @map("is_active")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([skillId, fingerprint])
  @@index([skillId, difficulty])
  @@map("check_questions")
}

// ---------------------------------------------------------------------------
// Practical tasks & learning resources
// ---------------------------------------------------------------------------

model PracticalTask {
  id                 String     @id @default(uuid()) @db.Uuid
  skillId            String     @map("skill_id") @db.Uuid
  title              String     @db.VarChar(200)
  description        String
  difficulty         Difficulty @default(EASY)
  /// Rubric the AI evaluator scores against.
  evaluationCriteria Json       @default("{}") @map("evaluation_criteria")
  /// Code (or an answer outline) pre-filled in the editor.
  starterCode        String?    @map("starter_code")
  isActive           Boolean    @default(true) @map("is_active")
  isDeleted          Boolean    @default(false) @map("is_deleted")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  skill       Skill                @relation(fields: [skillId], references: [id], onDelete: Restrict)
  submissions UserTaskSubmission[]

  @@index([skillId])
  @@map("practical_tasks")
}

model UserTaskSubmission {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  submissionContent String   @map("submission_content")
  /// Structured AI feedback, e.g. { summary, strengths: [], issues: [] }.
  aiFeedback        Json?    @map("ai_feedback")
  score             Float?
  passed            Boolean?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task PracticalTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([userId, taskId])
  @@map("user_task_submissions")
}

/// Curated material served for any topic flagged NEEDS_REVISION.
/// Either `url` (external, e.g. W3Schools) or `content` (hosted text) is set.
model LearningResource {
  id        String       @id @default(uuid()) @db.Uuid
  skillId   String       @map("skill_id") @db.Uuid
  title     String       @db.VarChar(200)
  type      ResourceType
  url       String?      @db.VarChar(1000)
  content   String?
  source    String?      @db.VarChar(100)
  isActive  Boolean      @default(true) @map("is_active")
  isDeleted Boolean      @default(false) @map("is_deleted")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([skillId])
  @@map("learning_resources")
}

// ---------------------------------------------------------------------------
// AI usage metering (SCRUM-129)
// ---------------------------------------------------------------------------

/// One row per call to the AI provider, written even while AI is free, so the
/// 3–5 month free trial (and any later paid tier) can be enforced without a rebuild.
model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// What the call was for, e.g. "onboarding", "assessment".
  feature      String   @db.VarChar(50)
  provider     String   @db.VarChar(30)
  model        String   @db.VarChar(100)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  latencyMs    Int      @map("latency_ms")
  success      Boolean
  /// A call the student didn't ask for (coach check-in, bank top-up script):
  /// recorded for cost tracking, but not counted against their daily limit.
  system       Boolean  @default(false)
  errorCode    String?  @map("error_code") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// ---------------------------------------------------------------------------
// Notifications (SCRUM-48)
// ---------------------------------------------------------------------------

/// In-app notifications. Written by services/notifications; a failed write
/// never blocks the action that triggered it.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// e.g. WELCOME, TASK_REVIEWED, PASSWORD_CHANGED. A string, not an enum, so
  /// Phase 2/3 events (session booked, mentor note) don't need a migration.
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(1000)
  /// App path the notification opens, e.g. /tasks/<id>.
  href      String?   @db.VarChar(500)
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// When a student is on the site, for the AI coach's once-a-day check-in.
/// The app pings while the tab is visible; a gap of over 10 minutes starts a
/// new session. After 30 minutes in one session the coach sends one tip.
model UserActivity {
  userId           String    @id @map("user_id") @db.Uuid
  sessionStartedAt DateTime  @map("session_started_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @map("last_seen_at") @db.Timestamptz(6)
  lastNudgeAt      DateTime? @map("last_nudge_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}

// ---------------------------------------------------------------------------
// Phase 2: interview question bank (docs/PHASE_2_PLAN.md)
// ---------------------------------------------------------------------------

/// Open-ended interview questions for practice. Not the skill-check MCQs
/// (check_questions). Tagged with a Phase 1 skill, so a weak skill on the
/// dashboard leads straight to matching questions.
model QuestionBank {
  id          String     @id @default(uuid()) @db.Uuid
  skillId     String     @map("skill_id") @db.Uuid
  title       String     @db.VarChar(200)
  /// Light formatting: blank line = paragraph, "- " = list, ``` = code.
  body        String
  /// Model answer / hints, hidden until the student asks to see it.
  answer      String?
  /// From the fixed lists in src/modules/questions/taxonomy.ts.
  company     String?    @db.VarChar(100)
  role        String?    @db.VarChar(100)
  topic       String     @db.VarChar(100)
  difficulty  Difficulty
  /// The admin who added it; null for the seeded starter bank.
  createdById String?    @map("created_by") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  skill     Skill                  @relation(fields: [skillId], references: [id], onDelete: Restrict)
  createdBy User?                  @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  progress  UserQuestionProgress[]

  @@unique([skillId, title])
  @@index([company])
  @@index([role])
  @@index([topic])
  @@map("question_bank")
}

/// One row per student per question, so bookmarking or solving twice never
/// duplicates. Bookmarked and solved are separate: a solved question can stay bookmarked.
model UserQuestionProgress {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  questionId   String    @map("question_id") @db.Uuid
  bookmarked   Boolean   @default(false)
  /// When it was last bookmarked; orders My bookmarks (solving doesn't reorder it).
  bookmarkedAt DateTime? @map("bookmarked_at") @db.Timestamptz(6)
  /// First time it was marked solved; null when not solved.
  solvedAt     DateTime? @map("solved_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, solvedAt])
  @@map("user_question_progress")
}

/// Curated prep guides. Admins paste a public link to the PDF (no file storage yet).
model PrepPdf {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  skillId     String?  @map("skill_id") @db.Uuid
  role        String?  @db.VarChar(100)
  company     String?  @db.VarChar(100)
  fileUrl     String   @map("file_url") @db.VarChar(500)
  /// Shown to students, e.g. "12 pages"; optional.
  sizeLabel   String?  @map("size_label") @db.VarChar(50)
  downloads   Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@map("prep_pdfs")
}
