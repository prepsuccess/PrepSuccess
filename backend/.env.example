# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8000

# Comma-separated list of allowed frontend origins (no "*" in production).
CORS_ORIGINS=http://localhost:3000

# Public URLs (no trailing slash). The Google redirect URI is
# ${API_PUBLIC_URL}/api/v1/auth/google/callback — register it in Google Cloud Console.
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Supabase Postgres (Project Settings -> Database -> Connection string).
# DATABASE_URL: pooled connection (port 6543) used by the app at runtime.
# DIRECT_URL:   direct/session connection (port 5432) used by Prisma migrations.
# For local Postgres, set both to postgresql://postgres:postgres@localhost:5432/prepsuccess
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# Google OAuth (SCRUM-12)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP for OTP emails (use a Gmail App Password, not your account password)
SMTP_USER=
SMTP_PASS=

# AI provider (Gemini free tier) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main model, and the fallback used when it's overloaded/rate-limited (empty disables).
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# AI_TIMEOUT_MS=30000
# Free trial from signup (days). Metered always; only blocks when AI_TRIAL_ENFORCED=true.
# AI_TRIAL_DAYS=120
# AI_TRIAL_ENFORCED=false
# Successful AI calls per user per day (resets at midnight IST).
# AI_DAILY_REQUEST_LIMIT=200

# Error tracking (optional). Create a Node project at sentry.io and paste its DSN.
# Check it works with: npm run sentry:test
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0

LOG_LEVEL=info

# Swagger UI at /docs. Defaults to on outside production.
# API_DOCS_ENABLED=true
