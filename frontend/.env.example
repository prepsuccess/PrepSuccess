# Backend origin, baked in at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Error tracking (optional). A Sentry "Next.js" project DSN; empty disables it.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging

# Product analytics (optional). A PostHog project key; empty disables it.
# Only named events are sent: no autocapture, recordings, cookies or personal data.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
