# Application Configuration
PROJECT_NAME="PrepSuccess API"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (Async for FastAPI, Sync for Alembic)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/prepsuccess_dev"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prepsuccess_dev"

# Security & JWT Tokens
JWT_SECRET_KEY="supersecretjwtkeychangeinproductionfortestingonly"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Observability
SENTRY_DSN=""
